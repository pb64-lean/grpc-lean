load("@rules_lean//lean:defs.bzl", "lean_binary", "lean_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "official_descriptor_set",
    srcs = ["official/descriptor_set.bin"],
)

lean_test(
    name = "proto3_test",
    srcs = ["Proto3Bazel.lean"],
    strip_module_prefix = "",
    deps = ["//:protobuf"],
)

lean_test(
    name = "direct_encode_test",
    srcs = [
        "DirectEncodeBazel.lean",
        "ImportedGeneratedChild.lean",
        "LegacyChild.lean",
    ],
    strip_module_prefix = "",
    deps = ["//:protobuf"],
)

lean_test(
    name = "varint_test",
    srcs = ["VarintBazel.lean"],
    strip_module_prefix = "",
    deps = ["//Protobuf/Encoding"],
)

lean_binary(
    name = "varint_benchmark",
    srcs = ["Bench/Varint.lean"],
    tags = ["manual"],
    strip_module_prefix = "",
    deps = ["//Protobuf/Encoding"],
)

lean_binary(
    name = "direct_encode_benchmark",
    srcs = ["Bench/DirectEncode.lean"],
    tags = ["manual"],
    strip_module_prefix = "",
    deps = ["//:protobuf"],
)

lean_test(
    name = "proto2_import_test",
    srcs = ["Proto2ImportBazel.lean"],
    compile_env = {
        "PROTOC": "$(location @protobuf//:protoc)",
    },
    compile_tools = ["@protobuf//:protoc"],
    data = ["Proto2Defaults.proto"],
    strip_module_prefix = "",
    deps = ["//:protobuf"],
)

lean_test(
    name = "proto2_groups_test",
    srcs = ["Proto2GroupsBazel.lean"],
    compile_env = {
        "PROTOC": "$(location @protobuf//:protoc)",
    },
    compile_tools = ["@protobuf//:protoc"],
    data = ["Proto2Groups.proto"],
    strip_module_prefix = "",
    deps = ["//:protobuf"],
)

lean_test(
    name = "desc_test",
    srcs = ["DescBazel.lean"],
    data = [":official_descriptor_set"],
    strip_module_prefix = "",
    deps = ["//:protobuf"],
)
