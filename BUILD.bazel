# rules_lean_grpc/BUILD.bazel
"""Root package for the rules_lean_grpc module.

The public API lives in defs.bzl; this file marks the module root package so that
@rules_lean_grpc//:defs.bzl and //:proto.bzl are loadable.
"""

package(default_visibility = ["//visibility:public"])

load("@rules_lean//lean:defs.bzl", "lean_assurance_test", "lean_library", "lean_test")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("//:defs.bzl", "lean_proto_library")

# The self-signed TLS test identity, so example/interop targets in other
# packages can depend on the same fixture the in-repo TLS tests use.
exports_files(glob(["Test/Fixtures/Tls/*"]))

proto_library(
    name = "recursive_struct_proto",
    srcs = ["Test/recursive_struct.proto"],
)

lean_proto_library(
    name = "recursive_struct_lean",
    proto = ":recursive_struct_proto",
    module_prefix = "RecursiveProtoTest",
)

lean_test(
    name = "recursive_struct_test",
    srcs = ["Test/RecursiveStructTest.lean"],
    deps = [
        ":recursive_struct_lean",
        "@grpc_lean_protobuf//:protobuf",
    ],
)

lean_library(
    name = "grpc_lean",
    srcs = [
        "Grpc.lean",
        "Grpc/Bytes.lean",
        "Grpc/CancellationToken.lean",
        "Grpc/Client.lean",
        "Grpc/Framing.lean",
        "Grpc/Http2.lean",
        "Grpc/Http2/Connection.lean",
        "Grpc/Http2/Frame.lean",
        "Grpc/Http2/Grpc.lean",
        "Grpc/Http2/Hpack.lean",
        "Grpc/Http2/Server.lean",
        "Grpc/Metadata.lean",
        "Grpc/Protocol.lean",
        "Grpc/Server.lean",
        "Grpc/Services/Health.lean",
        "Grpc/Services/Reflection.lean",
        "Grpc/Status.lean",
    ],
    deps = [
        "//Zlib:zlib",
        ":grpc_tls",
        "@grpc_lean_protobuf//:protobuf",
    ],
)

lean_library(
    name = "grpc_tls",
    srcs = [
        "Grpc/Tls/Session.lean",
        "Grpc/Tls/Rest.lean",
    ],
    deps = [
        "@tls13_lean//Tls:tls",
    ],
)

# Compile-time audit of everything this repository proves and of where its
# trusted C boundary sits. The principal theorems must exist, be theorems, and
# close over no axiom beyond the standard three; nothing in `Grpc.*` or `Zlib.*`
# may reach `sorryAx`; and `@[extern]` may appear only in `Zlib.Gzip`, which is
# the mechanical form of the README's claim that the zlib shim is the only C
# this repository adds to its trusted computing base.
#
# `allowed_axioms` is deliberately the bare standard three. No proof here uses
# `bv_decide`, so no generated LRAT-certificate axiom
# (`<lemma>._native.bv_decide.ax_1_5`) exists to allow; reaching for it in a
# proof a principal theorem depends on fails this audit, which is the point.
lean_assurance_test(
    name = "grpc_assurance",
    allowed_axioms = [
        "propext",
        "Classical.choice",
        "Quot.sound",
    ],
    allowed_extern_modules = ["Zlib.Gzip"],
    module_prefixes = [
        "Grpc",
        "Zlib",
    ],
    principal_theorems = [
        # Registry: well-formedness holds of the empty registry, is preserved by
        # checked registration, and makes method lookup unambiguous.
        "Grpc.Registry.empty_wellFormed",
        "Grpc.Registry.registerChecked_wellFormed",
        "Grpc.Registry.wellFormed_entry_unique",
        # Authorization before body: a stream rejected at HEADERS feeds no body
        # to a handler and dispatches none, over any trace of non-header frames.
        "Grpc.Http2.Connection.rejectStreamAtHeaders_inert",
        "Grpc.Http2.Connection.rejectStreamAtHeaders_frameTrace_no_dispatch",
        "Grpc.Http2.Connection.processDataShared_inert_reset",
        # Connection.WellFormed: holds initially and is preserved by every pure
        # frame transition.
        "Grpc.Http2.Connection.initialState_wellFormed",
        "Grpc.Http2.Connection.prepareHeadersShared_wellFormed",
        "Grpc.Http2.Connection.appendContinuationFrame_wellFormed",
        "Grpc.Http2.Connection.processNonHeaderFrameShared_wellFormed",
        "Grpc.Http2.Connection.prepareHeadersShared_no_reopen",
        "Grpc.Http2.Connection.prepareHeadersShared_concurrency",
        # Flow control: conservation, and the deadlock-freedom argument for
        # credit-on-consume.
        "Grpc.Http2.Connection.consumeInboundDataWindow_conserves",
        "Grpc.Http2.Connection.processUnaryRequestData_windows",
        "Grpc.Http2.Connection.processActiveRequestData_windows",
        "Grpc.Http2.Connection.decodeActiveRequestData_conserves",
        "Grpc.Http2.Connection.takeRequestStreamCredit_conserves",
        "Grpc.Http2.Connection.flushOutbound_conserves",
        "Grpc.Http2.Connection.defaultStreamWindow_admits_max_message",
        "Grpc.Http2.Connection.inboundWindow_pos_of_incomplete",
        # Codec laws, every one the README names.
        "Grpc.Http2.Hpack.decodeHuffman_encodeHuffman",
        "Grpc.Http2.Hpack.decodeString_encodeString",
        "Grpc.Http2.Hpack.decodeInteger_encodeInteger",
        "Grpc.Http2.Hpack.huffmanPrefixFree",
        "Grpc.Http2.Frame.decodeAll_encode_append",
        "Grpc.Http2.Frame.decodeHeader_encodeHeader_append",
        "Grpc.Message.decodeAll_encode_append",
        "Grpc.Message.decodeAllWithLimit_size_le",
        "Grpc.Percent.decode_encode",
        "Grpc.Timeout.parse?_render",
        "Grpc.Timeout.parse?_render_ofNanoseconds",
        "Grpc.Base64.decodeBytes_encodeBytes",
        "Grpc.Base64.decodeBytes_encodeBytesUnpadded",
    ],
    deps = [
        ":grpc_lean",
        "//Zlib:zlib",
    ],
)

# The TLS-facing layer declares no C of its own: every cryptographic primitive
# it reaches comes from tls13-lean's own audited HaclStar boundary, so no
# `@[extern]` may appear under `Grpc.Tls`.
lean_assurance_test(
    name = "grpc_tls_assurance",
    allowed_extern_modules = [],
    module_prefixes = ["Grpc.Tls"],
    deps = [":grpc_tls"],
)

lean_test(
    name = "zlib_test",
    srcs = ["Test/ZlibTest.lean"],
    deps = [
        ":grpc_lean",
        "//Zlib:zlib",
    ],
)

lean_test(
    name = "tls_handshake_test",
    srcs = ["Test/TlsHandshakeTest.lean"],
    data = glob(["Test/Fixtures/Tls/*"]),
    deps = ["@tls13_lean//Tls:tls"],
)

lean_test(
    name = "grpc_tls_test",
    srcs = ["Test/GrpcTlsTest.lean"],
    data = glob(["Test/Fixtures/Tls/*"]),
    # Loopback sockets are blocked in the darwin sandbox; run unsandboxed.
    # In-process client+server; run exclusively so concurrent socket tests do not
    # starve each other's worker pool (see the same-process handshake note).
    tags = ["no-sandbox", "exclusive"],
    deps = [":grpc_lean"],
)

