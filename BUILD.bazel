# Compile-time audit of everything this repository proves and of where its
# trusted C boundary sits. The principal theorems must exist, be theorems, and
# close over no axiom beyond the standard three; nothing in `Grpc.*` or `Zlib.*`
# may reach `sorryAx`; and the zlib adapter is the only C boundary implemented
# by this repository.
#
# `allowed_axioms` is deliberately the bare standard three. No proof here uses
# `bv_decide`, so no generated LRAT-certificate axiom
# (`<lemma>._native.bv_decide.ax_1_5`) exists to allow; reaching for it in a
# proof a principal theorem depends on fails this audit, which is the point.
lean_assurance_test(
    name = "grpc_assurance",
    policy_mode = "exact",
    allowed_axioms = [
        "propext",
        "Classical.choice",
        "Quot.sound",
    ],
    module_prefixes = [
        "Grpc",
        "Zlib",
    ],
    # Environment partition, discovered from the audit's own coverage report:
    # `Tls`/`TLS13`/`HaclStar` are tls13-lean modules audited by that
    # repository's own assurance targets; `Binary`/`Protobuf` are the vendored
    # third-party Lean-zh libraries (third_party/Lean-zh), deliberately outside
    # this audit's scope — no assurance target audits them today.
    unaudited_module_prefixes = [
        "Binary",
        "HaclStar",
        "Http2",
        "Protobuf",
        "TLS13",
        "Tls",
    ],
    principal_theorems = [
        # Registry: well-formedness holds of the empty registry, is preserved by
        # checked registration, and makes method lookup unambiguous.
        "Grpc.Registry.empty_wellFormed",
        "Grpc.Registry.registerChecked_wellFormed",
        "Grpc.Registry.wellFormed_entry_unique",
        # The configured stream receive window admits one maximum-size gRPC
        # message and its wire prefix before application consumption grants
        # more stream credit.
        "Grpc.Http2.Connection.defaultStreamWindow_admits_max_message",
        # gRPC codec laws.
        "Grpc.Message.decodeAll_encode_append",
        "Grpc.Message.decodeAllWithLimit_size_le",
        "Grpc.Percent.decode_encode",
        "Grpc.Timeout.parse?_render",
        "Grpc.Timeout.ofNanoseconds_bounds",
        "Grpc.Timeout.parse?_render_ofNanoseconds",
        "Grpc.Base64.decodeBytes_encodeBytes",
        "Grpc.Base64.decodeBytes_encodeBytesUnpadded",
        # The generated-code gzip accept-encoding parser is extensionally the
        # former split/trim/list parser for every input string.
        "Grpc.Headers.valueAcceptsGzipCandidate_eq_valueAcceptsGzip",
        # Channel-lease kernel: unique bounded leases, draining stops
        # admission, close requires drained, and phase-preservation equations.
        "Grpc.ChannelLease.State.invariant",
        "Grpc.ChannelLease.State.closed_has_no_leases",
        "Grpc.ChannelLease.State.closed_active_count_zero",
        "Grpc.ChannelLease.acquire_success_starts_accepting",
        "Grpc.ChannelLease.acquire_adds_exact_lease",
        "Grpc.ChannelLease.acquire_preserves_invariant",
        "Grpc.ChannelLease.release_removes_exact_lease",
        "Grpc.ChannelLease.begin_close_stops_admission",
        "Grpc.ChannelLease.draining_rejects_acquire",
        "Grpc.ChannelLease.begin_close_claim_invalidates_admission",
        "Grpc.ChannelLease.finish_close_is_clean",
        "Grpc.ChannelLease.finish_close_requires_drained",
        "Grpc.ChannelLease.active_channel_cannot_finish",
        "Grpc.ChannelLease.acquire_preserves_phase",
        "Grpc.ChannelLease.release_preserves_phase",
        "Grpc.ChannelLease.beginClose_phase_nonaccepting",
        "Grpc.ChannelLease.beginClose_closed_implies_closed",
        "Grpc.ChannelLease.beginClose_activeCount",
        # Managed channel: every atomic supervisor snapshot carries the
        # production invariant, clean close is exactly empty custody, and
        # generation retirement matches the transport-ambiguous code set.
        "Grpc.ManagedChannel.TestSupport.SupervisorSnapshot.invariant",
        "Grpc.CleanupInventory.isClean_iff",
        "Grpc.ManagedChannel.rpcCodeRequiresGenerationRetirement_iff",
        # Channel configuration and credentials.
        "Grpc.Endpoint.tls_iff_https",
        "Grpc.RpcDeadline.positive",
        "Grpc.RpcDeadline.bounded",
        "Grpc.CredentialEntry.visible_ascii",
        "Grpc.CredentialEntry.lowercase_name",
        "Grpc.CredentialEntry.authorization_name",
        # Channel-initialization ownership kernel for a future cancellable
        # connector.
        "Grpc.ChannelInitialization.State.at_most_one_initialization",
        "Grpc.ChannelInitialization.State.ownership_partitions_are_disjoint",
        "Grpc.ChannelInitialization.State.retained_sockets_are_unique",
        "Grpc.ChannelInitialization.State.owned_socket_precedes_allocator",
        "Grpc.ChannelInitialization.State.pending_and_current_are_exclusive",
        "Grpc.ChannelInitialization.State.pending_socket_not_retained",
        "Grpc.ChannelInitialization.State.current_socket_not_retained",
        "Grpc.ChannelInitialization.State.draining_initialization_has_cancellation_requested",
        "Grpc.ChannelInitialization.State.retained_sockets_bounded",
        "Grpc.ChannelInitialization.State.closed_has_no_owners",
        "Grpc.ChannelInitialization.State.closed_owned_sockets_empty",
        "Grpc.ChannelInitialization.State.closed_owner_count_zero",
        "Grpc.ChannelInitialization.State.owner_count_bounded",
        "Grpc.ChannelInitialization.start_allocates_monotone_attempt",
        "Grpc.ChannelInitialization.cancellation_requested_cannot_publish",
        "Grpc.ChannelInitialization.cancelled_cannot_publish",
        "Grpc.ChannelInitialization.retain_capacity_preserves_current_owner",
        "Grpc.ChannelInitialization.begin_close_cancels_publication",
        "Grpc.ChannelInitialization.finish_close_requires_released",
        "Grpc.ChannelInitialization.unreleased_owner_blocks_close",
        "Grpc.ChannelInitialization.finish_close_is_empty",
    ],
    principal_theorem_types = {
        "Grpc.Registry.empty_wellFormed": "Grpc.Registry.empty.WellFormed",
        "Grpc.Registry.registerChecked_wellFormed": "∀ {registry registry' : Grpc.Registry} {entry : Grpc.MethodEntry} (hwf : registry.WellFormed) (h : registry.registerChecked entry = Except.ok registry'), registry'.WellFormed",
        "Grpc.Registry.wellFormed_entry_unique": "∀ {registry : Grpc.Registry} {e₁ e₂ : Grpc.MethodEntry} (hwf : registry.WellFormed) (h₁ : e₁ ∈ registry.entries) (h₂ : e₂ ∈ registry.entries) (hname : e₁.name = e₂.name), e₁ = e₂",
        "Grpc.Http2.Connection.defaultStreamWindow_admits_max_message": "Grpc.Message.prefixLength + Grpc.Message.defaultMaxDecompressedSize ≤ Grpc.Http2.Connection.defaultStreamWindow",
        "Grpc.Message.decodeAll_encode_append": "∀ {x : Grpc.Message} {bs : ByteArray} (henc : x.encode = Except.ok bs) (rest : ByteArray), Grpc.Message.decodeAll (bs ++ rest) = Except.map (fun messages => #[x] ++ messages) (Grpc.Message.decodeAll rest)",
        "Grpc.Message.decodeAllWithLimit_size_le": "∀ {maxDataSize : Nat} {bytes : ByteArray} {messages : Array Grpc.Message} (h : Grpc.Message.decodeAllWithLimit (some maxDataSize) bytes = Except.ok messages) (message : Grpc.Message), message ∈ messages → message.data.size ≤ maxDataSize",
        "Grpc.Percent.decode_encode": "∀ (message : String), Grpc.Percent.decode (Grpc.Percent.encode message) = Except.ok message",
        "Grpc.Timeout.parse?_render": "∀ (timeout : Grpc.Timeout) (hpos : timeout.value ≠ 0) (hle : timeout.value ≤ 99999999), Grpc.Timeout.parse? timeout.render = some timeout",
        "Grpc.Timeout.ofNanoseconds_bounds": "∀ (nanoseconds : Nat), (Grpc.Timeout.ofNanoseconds nanoseconds).value ≠ 0 ∧ (Grpc.Timeout.ofNanoseconds nanoseconds).value ≤ Grpc.Timeout.maxRenderedValue",
        "Grpc.Timeout.parse?_render_ofNanoseconds": "∀ (nanoseconds : Nat), Grpc.Timeout.parse? (Grpc.Timeout.ofNanoseconds nanoseconds).render = some (Grpc.Timeout.ofNanoseconds nanoseconds)",
        "Grpc.Base64.decodeBytes_encodeBytes": "∀ (bytes : ByteArray), Grpc.Base64.decodeBytes (Grpc.Base64.encodeBytes bytes) = Except.ok bytes",
        "Grpc.Base64.decodeBytes_encodeBytesUnpadded": "∀ (bytes : ByteArray), Grpc.Base64.decodeBytes (Grpc.Base64.encodeBytesUnpadded bytes) = Except.ok bytes",
        "Grpc.Headers.valueAcceptsGzipCandidate_eq_valueAcceptsGzip": "∀ (value : String), Grpc.Headers.TestSupport.valueAcceptsGzipCandidateForBenchmark value = Grpc.Headers.valueAcceptsGzip value",
        "Grpc.ChannelLease.State.invariant": "∀ (state : Grpc.ChannelLease.State), state.Invariant",
        "Grpc.ChannelLease.State.closed_has_no_leases": "∀ (state : Grpc.ChannelLease.State) (closed : state.phase = Grpc.ChannelLease.Phase.closed), state.activeLeases = []",
        "Grpc.ChannelLease.State.closed_active_count_zero": "∀ (state : Grpc.ChannelLease.State) (closed : state.phase = Grpc.ChannelLease.Phase.closed), state.activeCount = 0",
        "Grpc.ChannelLease.acquire_success_starts_accepting": "∀ (state : Grpc.ChannelLease.State) (grant : Grpc.ChannelLease.Grant) (accepted : Grpc.ChannelLease.acquire state = Except.ok grant), state.phase = Grpc.ChannelLease.Phase.accepting",
        "Grpc.ChannelLease.acquire_adds_exact_lease": "∀ (state : Grpc.ChannelLease.State) (grant : Grpc.ChannelLease.Grant) (accepted : Grpc.ChannelLease.acquire state = Except.ok grant), grant.state.activeCount = state.activeCount + 1 ∧ grant.state.owns grant.lease = true",
        "Grpc.ChannelLease.acquire_preserves_invariant": "∀ (state : Grpc.ChannelLease.State) (grant : Grpc.ChannelLease.Grant) (accepted : Grpc.ChannelLease.acquire state = Except.ok grant), grant.state.Invariant",
        "Grpc.ChannelLease.release_removes_exact_lease": "∀ (state next : Grpc.ChannelLease.State) (lease : Grpc.ChannelLease.Lease) (released : Grpc.ChannelLease.release state lease = Except.ok next), next.activeCount + 1 = state.activeCount ∧ next.owns lease = false",
        "Grpc.ChannelLease.begin_close_stops_admission": "∀ (state : Grpc.ChannelLease.State), (Grpc.ChannelLease.beginClose state).state.phase ≠ Grpc.ChannelLease.Phase.accepting ∨ (Grpc.ChannelLease.beginClose state).decision = Grpc.ChannelLease.BeginCloseDecision.completed",
        "Grpc.ChannelLease.draining_rejects_acquire": "∀ (state : Grpc.ChannelLease.State) (draining : state.phase = Grpc.ChannelLease.Phase.draining), Grpc.ChannelLease.acquire state = Except.error Grpc.ChannelLease.AcquireError.draining",
        "Grpc.ChannelLease.begin_close_claim_invalidates_admission": "∀ (state : Grpc.ChannelLease.State) (claimed : (Grpc.ChannelLease.beginClose state).decision = Grpc.ChannelLease.BeginCloseDecision.claimed), (Grpc.ChannelLease.beginClose state).state.phase = Grpc.ChannelLease.Phase.draining ∧ ∀ (grant : Grpc.ChannelLease.Grant), Grpc.ChannelLease.acquire (Grpc.ChannelLease.beginClose state).state ≠ Except.ok grant",
        "Grpc.ChannelLease.finish_close_is_clean": "∀ (state closed : Grpc.ChannelLease.State) (finished : Grpc.ChannelLease.finishClose state = Except.ok closed), closed.phase = Grpc.ChannelLease.Phase.closed ∧ closed.activeCount = 0",
        "Grpc.ChannelLease.finish_close_requires_drained": "∀ (state closed : Grpc.ChannelLease.State) (finished : Grpc.ChannelLease.finishClose state = Except.ok closed), state.activeCount = 0",
        "Grpc.ChannelLease.active_channel_cannot_finish": "∀ (state : Grpc.ChannelLease.State) (positive : 0 < state.activeCount) (closed : Grpc.ChannelLease.State), Grpc.ChannelLease.finishClose state ≠ Except.ok closed",
        "Grpc.ChannelLease.acquire_preserves_phase": "∀ (state : Grpc.ChannelLease.State) (grant : Grpc.ChannelLease.Grant) (accepted : Grpc.ChannelLease.acquire state = Except.ok grant), grant.state.phase = state.phase",
        "Grpc.ChannelLease.release_preserves_phase": "∀ (state next : Grpc.ChannelLease.State) (lease : Grpc.ChannelLease.Lease) (released : Grpc.ChannelLease.release state lease = Except.ok next), next.phase = state.phase",
        "Grpc.ChannelLease.beginClose_phase_nonaccepting": "∀ (model : Grpc.ChannelLease.State), (Grpc.ChannelLease.beginClose model).state.phase ≠ Grpc.ChannelLease.Phase.accepting",
        "Grpc.ChannelLease.beginClose_closed_implies_closed": "∀ (model : Grpc.ChannelLease.State) (closed : (Grpc.ChannelLease.beginClose model).state.phase = Grpc.ChannelLease.Phase.closed), model.phase = Grpc.ChannelLease.Phase.closed",
        "Grpc.ChannelLease.beginClose_activeCount": "∀ (model : Grpc.ChannelLease.State), (Grpc.ChannelLease.beginClose model).state.activeCount = model.activeCount",
        "Grpc.ManagedChannel.TestSupport.SupervisorSnapshot.invariant": "∀ (snapshot : Grpc.ManagedChannel.TestSupport.SupervisorSnapshot), snapshot.Invariant",
        "Grpc.CleanupInventory.isClean_iff": "∀ (inventory : Grpc.CleanupInventory), inventory.isClean = true ↔ inventory.channelOwners = 0 ∧ inventory.initializationOwners = 0 ∧ inventory.uncertainInitializations = 0 ∧ inventory.invariantInitializations = 0 ∧ inventory.pendingInitializations = 0",
        "Grpc.ManagedChannel.rpcCodeRequiresGenerationRetirement_iff": "∀ (code : Grpc.Code), Grpc.ManagedChannel.rpcCodeRequiresGenerationRetirement code = true ↔ code ∈ Grpc.ManagedChannel.transportAmbiguousRpcCodes",
        "Grpc.Endpoint.tls_iff_https": "∀ (endpoint : Grpc.Endpoint), endpoint.useTls = true ↔ endpoint.scheme = Grpc.Scheme.https",
        "Grpc.RpcDeadline.positive": "∀ (deadline : Grpc.RpcDeadline), 0 < deadline.seconds",
        "Grpc.RpcDeadline.bounded": "∀ (deadline : Grpc.RpcDeadline), deadline.seconds ≤ Grpc.maxGrpcTimeoutSeconds",
        "Grpc.CredentialEntry.visible_ascii": "∀ (entry : Grpc.CredentialEntry), Grpc.isVisibleAsciiMetadataValue entry.exposeValue = true",
        "Grpc.CredentialEntry.lowercase_name": "∀ (entry : Grpc.CredentialEntry), Grpc.isMetadataKeyName entry.name = true",
        "Grpc.CredentialEntry.authorization_name": "∀ (value : String) (h : Grpc.isVisibleAsciiMetadataValue value = true), (Grpc.CredentialEntry.authorization value h).name = \"authorization\"",
        "Grpc.ChannelInitialization.State.at_most_one_initialization": "∀ (state : Grpc.ChannelInitialization.State) (left right : Grpc.ChannelInitialization.Pending), state.pending = some left → state.pending = some right → left = right",
        "Grpc.ChannelInitialization.State.ownership_partitions_are_disjoint": "∀ (state : Grpc.ChannelInitialization.State), state.ownedSockets.Nodup",
        "Grpc.ChannelInitialization.State.retained_sockets_are_unique": "∀ (state : Grpc.ChannelInitialization.State), state.retained.Nodup",
        "Grpc.ChannelInitialization.State.owned_socket_precedes_allocator": "∀ (state : Grpc.ChannelInitialization.State) (token : Grpc.ChannelInitialization.SocketToken) (owned : token ∈ state.ownedSockets), token.value < state.nextSocket",
        "Grpc.ChannelInitialization.State.pending_and_current_are_exclusive": "∀ (state : Grpc.ChannelInitialization.State) (pending : Grpc.ChannelInitialization.Pending) (present : state.pending = some pending), state.current = none",
        "Grpc.ChannelInitialization.State.pending_socket_not_retained": "∀ (state : Grpc.ChannelInitialization.State) (pending : Grpc.ChannelInitialization.Pending) (token : Grpc.ChannelInitialization.SocketToken) (pendingPresent : state.pending = some pending) (socketPresent : pending.socket = some token), token ∉ state.retained",
        "Grpc.ChannelInitialization.State.current_socket_not_retained": "∀ (state : Grpc.ChannelInitialization.State) (connection : Grpc.ChannelInitialization.Connection) (currentPresent : state.current = some connection), connection.socket ∉ state.retained",
        "Grpc.ChannelInitialization.State.draining_initialization_has_cancellation_requested": "∀ (state : Grpc.ChannelInitialization.State) (draining : state.phase = Grpc.ChannelInitialization.Phase.draining) (pending : Grpc.ChannelInitialization.Pending) (present : state.pending = some pending), pending.stage.CancellationRequested",
        "Grpc.ChannelInitialization.State.retained_sockets_bounded": "∀ (state : Grpc.ChannelInitialization.State), state.retained.length ≤ Grpc.ChannelInitialization.maximumRetainedSockets",
        "Grpc.ChannelInitialization.State.closed_has_no_owners": "∀ (state : Grpc.ChannelInitialization.State) (closed : state.phase = Grpc.ChannelInitialization.Phase.closed), state.pending = none ∧ state.current = none ∧ state.retained = []",
        "Grpc.ChannelInitialization.State.closed_owned_sockets_empty": "∀ (state : Grpc.ChannelInitialization.State) (closed : state.phase = Grpc.ChannelInitialization.Phase.closed), state.ownedSockets = []",
        "Grpc.ChannelInitialization.State.closed_owner_count_zero": "∀ (state : Grpc.ChannelInitialization.State) (closed : state.phase = Grpc.ChannelInitialization.Phase.closed), state.ownerCount = 0",
        "Grpc.ChannelInitialization.State.owner_count_bounded": "∀ (state : Grpc.ChannelInitialization.State), state.ownerCount ≤ Grpc.ChannelInitialization.maximumRetainedSockets + 1",
        "Grpc.ChannelInitialization.start_allocates_monotone_attempt": "∀ (state : Grpc.ChannelInitialization.State) (result : Grpc.ChannelInitialization.StartResult) (started : Grpc.ChannelInitialization.start state = Except.ok result), result.attempt.value = state.nextAttempt ∧ result.state.nextAttempt = state.nextAttempt + 1",
        "Grpc.ChannelInitialization.cancellation_requested_cannot_publish": "∀ (state : Grpc.ChannelInitialization.State) (attempt : Grpc.ChannelInitialization.AttemptId) (socket : Grpc.ChannelInitialization.SocketToken) (pending : Grpc.ChannelInitialization.Pending) (present : state.pending = some pending) (cancelled : pending.stage.CancellationRequested) (result : Grpc.ChannelInitialization.PublishResult), Grpc.ChannelInitialization.publish state attempt socket ≠ Except.ok result",
        "Grpc.ChannelInitialization.cancelled_cannot_publish": "∀ (state : Grpc.ChannelInitialization.State) (attempt : Grpc.ChannelInitialization.AttemptId) (socket : Grpc.ChannelInitialization.SocketToken) (pending : Grpc.ChannelInitialization.Pending) (present : state.pending = some pending) (cancelled : pending.stage = Grpc.ChannelInitialization.Stage.cancelling) (result : Grpc.ChannelInitialization.PublishResult), Grpc.ChannelInitialization.publish state attempt socket ≠ Except.ok result",
        "Grpc.ChannelInitialization.retain_capacity_preserves_current_owner": "∀ (state : Grpc.ChannelInitialization.State) (overflow : Grpc.ChannelInitialization.retainCurrent state = Except.error Grpc.ChannelInitialization.RetainError.capacity), state.current.isSome = true ∧ state.retained.length = Grpc.ChannelInitialization.maximumRetainedSockets",
        "Grpc.ChannelInitialization.begin_close_cancels_publication": "∀ (state : Grpc.ChannelInitialization.State) (pending : Grpc.ChannelInitialization.Pending) (present : (Grpc.ChannelInitialization.beginClose state).state.pending = some pending) (notCompleted : (Grpc.ChannelInitialization.beginClose state).decision ≠ Grpc.ChannelInitialization.BeginCloseDecision.completed), pending.stage.CancellationRequested",
        "Grpc.ChannelInitialization.finish_close_requires_released": "∀ (state closed : Grpc.ChannelInitialization.State) (finished : Grpc.ChannelInitialization.finishClose state = Except.ok closed), state.phase = Grpc.ChannelInitialization.Phase.draining ∧ state.pending = none ∧ state.current = none ∧ state.retained = []",
        "Grpc.ChannelInitialization.unreleased_owner_blocks_close": "∀ (state : Grpc.ChannelInitialization.State) (positive : 0 < state.ownerCount) (closed : Grpc.ChannelInitialization.State), Grpc.ChannelInitialization.finishClose state ≠ Except.ok closed",
        "Grpc.ChannelInitialization.finish_close_is_empty": "∀ (state closed : Grpc.ChannelInitialization.State) (finished : Grpc.ChannelInitialization.finishClose state = Except.ok closed), closed.phase = Grpc.ChannelInitialization.Phase.closed ∧ closed.pending = none ∧ closed.current = none ∧ closed.retained = [] ∧ closed.ownedSockets = []",
    },
    expected_unsafe_constants = [],
    expected_partial_definitions = [
        "Grpc.Http2.Connection.DeadlineScheduler.loop",
        "Grpc.Http2.Connection.emitStreamingMessagesShared",
        "Grpc.Http2.Connection.flushResponses",
        "Grpc.MessageStream.collect",
        "Grpc.Client.collectResponses",
        "Grpc.Client.readerLoop",
        "Grpc.Client.Call.recvLoop",
        "Grpc.Client.writerLoop",
        "Grpc.Client.Call.finish",
        "Grpc.Client.Call.sendChunks",
        "Grpc.Client.startLoop",
