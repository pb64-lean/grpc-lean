# Compile-time audit of everything this repository proves and of where its
# trusted C boundary sits. The principal theorems must exist, be theorems, and
# close over no axiom beyond the standard three; nothing in `Grpc.*` or `Zlib.*`
# may reach `sorryAx`; and `@[extern]` may appear only in `Zlib.Gzip` and
# `Grpc.Posix`, which is the mechanical form of the README's claim that the
# zlib shim and the POSIX descriptor shim (whose extern ABI is additionally
# compile-checked by //native:posix_extern_abi_compile) are the only C this
# repository adds to its trusted computing base.
#
# `allowed_axioms` is deliberately the bare standard three. No proof here uses
# `bv_decide`, so no generated LRAT-certificate axiom
# (`<lemma>._native.bv_decide.ax_1_5`) exists to allow; reaching for it in a
# proof a principal theorem depends on fails this audit, which is the point.
lean_assurance_test(
    name = "grpc_assurance",
    policy_mode = "exact",
    allowed_axioms = [
        "propext",
        "Classical.choice",
        "Quot.sound",
    ],
    module_prefixes = [
        "Grpc",
        "Zlib",
    ],
    # Environment partition, discovered from the audit's own coverage report:
    # `Tls`/`TLS13`/`HaclStar` are tls13-lean modules audited by that
    # repository's own assurance targets; `Binary`/`Protobuf` are the vendored
    # third-party Lean-zh libraries (third_party/Lean-zh), deliberately outside
    # this audit's scope — no assurance target audits them today.
    unaudited_module_prefixes = [
        "Binary",
        "HaclStar",
        "Protobuf",
        "TLS13",
        "Tls",
    ],
    principal_theorems = [
        # Registry: well-formedness holds of the empty registry, is preserved by
        # checked registration, and makes method lookup unambiguous.
        "Grpc.Registry.empty_wellFormed",
        "Grpc.Registry.registerChecked_wellFormed",
        "Grpc.Registry.wellFormed_entry_unique",
        # Authorization before body: a stream rejected at HEADERS feeds no body
        # to a handler and dispatches none, over any trace of non-header frames.
        "Grpc.Http2.Connection.rejectStreamAtHeaders_inert",
        "Grpc.Http2.Connection.rejectStreamAtHeaders_tables",
        "Grpc.Http2.Connection.rejectStreamAtHeaders_frameTrace_no_dispatch",
        "Grpc.Http2.Connection.processDataShared_inert_reset",
        # Connection.WellFormed: holds initially and is preserved by every pure
        # frame transition.
        "Grpc.Http2.Connection.initialState_wellFormed",
        "Grpc.Http2.Connection.prepareHeadersShared_wellFormed",
        "Grpc.Http2.Connection.appendContinuationFrame_wellFormed",
        "Grpc.Http2.Connection.processNonHeaderFrameShared_wellFormed",
        "Grpc.Http2.Connection.prepareHeadersShared_no_reopen",
        "Grpc.Http2.Connection.prepareHeadersShared_concurrency",
        # Flow control: conservation, and the deadlock-freedom argument for
        # credit-on-consume.
        "Grpc.Http2.Connection.consumeInboundDataWindow_conserves",
        "Grpc.Http2.Connection.resetStreamFlowControl_scoped",
        "Grpc.Http2.Connection.processUnaryRequestData_windows",
        "Grpc.Http2.Connection.processActiveRequestData_windows",
        "Grpc.Http2.Connection.decodeActiveRequestData_conserves",
        "Grpc.Http2.Connection.takeRequestStreamCredit_conserves",
        "Grpc.Http2.Connection.flushOutbound_conserves",
        "Grpc.Http2.Connection.queueOutbound_conserves",
        "Grpc.Http2.Connection.queueOutbound_wellFormed",
        "Grpc.Http2.Connection.defaultStreamWindow_admits_max_message",
        "Grpc.Http2.Connection.inboundWindow_pos_of_incomplete",
        # Codec laws, every one the README names.
        "Grpc.Http2.Hpack.decodeHuffman_encodeHuffman",
        "Grpc.Http2.Hpack.decodeString_encodeString",
        "Grpc.Http2.Hpack.decodeInteger_encodeInteger",
        "Grpc.Http2.Hpack.huffmanPrefixFree",
        "Grpc.Http2.Hpack.dynamicSize_resize_le",
        "Grpc.Http2.Hpack.dynamicSize_insert_le",
        "Grpc.Http2.Hpack.dynamicSize_resizeChecked_le",
        "Grpc.Http2.Hpack.dynamicSize_setMaxAllowedSize_le",
        "Grpc.Http2.Frame.decodeAll_encode_append",
        "Grpc.Http2.Frame.decodeHeader_encodeHeader_append",
        "Grpc.Message.decodeAll_encode_append",
        "Grpc.Message.decodeAllWithLimit_size_le",
        "Grpc.Percent.decode_encode",
        "Grpc.Timeout.parse?_render",
        "Grpc.Timeout.ofNanoseconds_bounds",
        "Grpc.Timeout.parse?_render_ofNanoseconds",
        "Grpc.Base64.decodeBytes_encodeBytes",
        "Grpc.Base64.decodeBytes_encodeBytesUnpadded",
        # The generated-code gzip accept-encoding parser is extensionally the
        # former split/trim/list parser for every input string.
        "Grpc.Headers.valueAcceptsGzipCandidate_eq_valueAcceptsGzip",
        # Successful unary response frame assembly preserves the former
        # splitter/append encoder for every HPACK state, response, and limit.
        "Grpc.Http2.Transport.encodeUnaryResponseFramesCandidate_eq_encodeUnaryResponseFrames",
        # Channel-lease kernel: unique bounded leases, draining stops
        # admission, close requires drained, and phase-preservation equations.
        "Grpc.ChannelLease.State.invariant",
        "Grpc.ChannelLease.State.closed_has_no_leases",
        "Grpc.ChannelLease.State.closed_active_count_zero",
        "Grpc.ChannelLease.acquire_success_starts_accepting",
        "Grpc.ChannelLease.acquire_adds_exact_lease",
        "Grpc.ChannelLease.acquire_preserves_invariant",
        "Grpc.ChannelLease.release_removes_exact_lease",
        "Grpc.ChannelLease.begin_close_stops_admission",
        "Grpc.ChannelLease.draining_rejects_acquire",
        "Grpc.ChannelLease.begin_close_claim_invalidates_admission",
        "Grpc.ChannelLease.finish_close_is_clean",
        "Grpc.ChannelLease.finish_close_requires_drained",
        "Grpc.ChannelLease.active_channel_cannot_finish",
        "Grpc.ChannelLease.acquire_preserves_phase",
        "Grpc.ChannelLease.release_preserves_phase",
        "Grpc.ChannelLease.beginClose_phase_nonaccepting",
        "Grpc.ChannelLease.beginClose_closed_implies_closed",
        "Grpc.ChannelLease.beginClose_activeCount",
        # Managed channel: every atomic supervisor snapshot carries the
        # production invariant, clean close is exactly empty custody, and
        # generation retirement matches the transport-ambiguous code set.
        "Grpc.ManagedChannel.TestSupport.SupervisorSnapshot.invariant",
        "Grpc.CleanupInventory.isClean_iff",
        "Grpc.ManagedChannel.rpcCodeRequiresGenerationRetirement_iff",
        # Channel configuration and credentials.
        "Grpc.Endpoint.tls_iff_https",
        "Grpc.RpcDeadline.positive",
        "Grpc.RpcDeadline.bounded",
        "Grpc.CredentialEntry.visible_ascii",
        "Grpc.CredentialEntry.lowercase_name",
        "Grpc.CredentialEntry.authorization_name",
        # Channel-initialization ownership kernel for a future cancellable
        # connector.
        "Grpc.ChannelInitialization.State.at_most_one_initialization",
        "Grpc.ChannelInitialization.State.ownership_partitions_are_disjoint",
        "Grpc.ChannelInitialization.State.retained_sockets_are_unique",
        "Grpc.ChannelInitialization.State.owned_socket_precedes_allocator",
        "Grpc.ChannelInitialization.State.pending_and_current_are_exclusive",
        "Grpc.ChannelInitialization.State.pending_socket_not_retained",
        "Grpc.ChannelInitialization.State.current_socket_not_retained",
        "Grpc.ChannelInitialization.State.draining_initialization_has_cancellation_requested",
        "Grpc.ChannelInitialization.State.retained_sockets_bounded",
        "Grpc.ChannelInitialization.State.closed_has_no_owners",
        "Grpc.ChannelInitialization.State.closed_owned_sockets_empty",
        "Grpc.ChannelInitialization.State.closed_owner_count_zero",
        "Grpc.ChannelInitialization.State.owner_count_bounded",
        "Grpc.ChannelInitialization.start_allocates_monotone_attempt",
        "Grpc.ChannelInitialization.cancellation_requested_cannot_publish",
        "Grpc.ChannelInitialization.cancelled_cannot_publish",
        "Grpc.ChannelInitialization.retain_capacity_preserves_current_owner",
        "Grpc.ChannelInitialization.begin_close_cancels_publication",
        "Grpc.ChannelInitialization.finish_close_requires_released",
        "Grpc.ChannelInitialization.unreleased_owner_blocks_close",
        "Grpc.ChannelInitialization.finish_close_is_empty",
    ],
    principal_theorem_types = {
        "Grpc.Registry.empty_wellFormed": "Grpc.Registry.empty.WellFormed",
        "Grpc.Registry.registerChecked_wellFormed": "∀ {registry registry' : Grpc.Registry} {entry : Grpc.MethodEntry} (hwf : registry.WellFormed) (h : registry.registerChecked entry = Except.ok registry'), registry'.WellFormed",
        "Grpc.Registry.wellFormed_entry_unique": "∀ {registry : Grpc.Registry} {e₁ e₂ : Grpc.MethodEntry} (hwf : registry.WellFormed) (h₁ : e₁ ∈ registry.entries) (h₂ : e₂ ∈ registry.entries) (hname : e₁.name = e₂.name), e₁ = e₂",
        "Grpc.Http2.Connection.rejectStreamAtHeaders_inert": "∀ (state : Grpc.Http2.Connection.State) (streamId : Nat) (inboundHpack outboundHpack : Grpc.Http2.Hpack.State) (endStream : Bool) (hclaimed : streamId ≤ state.lastClientStreamId) (hactive : ∀ (active : Grpc.Http2.Connection.ActiveRequestStream), active ∈ state.activeRequestStreams → active.streamId ≠ streamId), (Grpc.Http2.Connection.rejectStreamAtHeaders state streamId inboundHpack outboundHpack endStream).StreamInert streamId",
        "Grpc.Http2.Connection.rejectStreamAtHeaders_tables": "∀ (state : Grpc.Http2.Connection.State) (streamId : Nat) (inboundHpack outboundHpack : Grpc.Http2.Hpack.State) (endStream : Bool), let rejected := Grpc.Http2.Connection.rejectStreamAtHeaders state streamId inboundHpack outboundHpack endStream; rejected.hpack = inboundHpack ∧ rejected.outboundHpack = outboundHpack",
        "Grpc.Http2.Connection.rejectStreamAtHeaders_frameTrace_no_dispatch": "∀ {registry : Grpc.Registry} {state final : Grpc.Http2.Connection.State} {steps : List (Grpc.Http2.Frame × Grpc.Http2.Connection.SharedFrameResult)} (streamId : Nat) (inboundHpack outboundHpack : Grpc.Http2.Hpack.State) (endStream : Bool) (hclaimed : streamId ≤ state.lastClientStreamId) (hactive : ∀ (active : Grpc.Http2.Connection.ActiveRequestStream), active ∈ state.activeRequestStreams → active.streamId ≠ streamId) (trace : Grpc.Http2.Connection.FrameTrace registry (Grpc.Http2.Connection.rejectStreamAtHeaders state streamId inboundHpack outboundHpack endStream) steps final) (hdata : ∀ (step : Grpc.Http2.Frame × Grpc.Http2.Connection.SharedFrameResult), step ∈ steps → step.fst.header.frameType = Grpc.Http2.FrameType.data → step.fst.header.streamId = streamId), final.StreamInert streamId ∧ (∀ (step : Grpc.Http2.Frame × Grpc.Http2.Connection.SharedFrameResult), step ∈ steps → step.snd.requestFeeds = #[] ∧ step.snd.detached = none ∧ step.snd.requestStreaming = none)",
        "Grpc.Http2.Connection.processDataShared_inert_reset": "∀ {registry : Grpc.Registry} {state state' : Grpc.Http2.Connection.State} {frame : Grpc.Http2.Frame} {result : Grpc.Http2.Connection.SharedFrameResult} (hinert : state.StreamInert frame.header.streamId) (hnotrej : state.rejectedAtHeaders frame.header.streamId = false) (h : Grpc.Http2.Connection.processDataShared registry state frame = Except.ok (state', result)), result.requestFeeds = #[] ∧ result.detached = none ∧ result.requestStreaming = none ∧ (∀ (dispatch : Grpc.Http2.Connection.ActiveDispatch), dispatch ∈ result.cancelDispatches → dispatch.streamId = frame.header.streamId) ∧ state'.streams = Grpc.Http2.Connection.removeStream state.streams frame.header.streamId ∧ state'.lastClientStreamId = state.lastClientStreamId ∧ (∀ (active : Grpc.Http2.Connection.ActiveRequestStream), active ∈ state'.activeRequestStreams → active ∈ state.activeRequestStreams) ∧ (∃ rst, rst ∈ result.emitted ∧ rst.header.frameType = Grpc.Http2.FrameType.rstStream ∧ rst.header.streamId = frame.header.streamId)",
