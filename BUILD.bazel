        "Grpc.Http2.Connection.prepareHeadersShared_wellFormed": "∀ {state : Grpc.Http2.Connection.State} {frame : Grpc.Http2.Frame} {res : Grpc.Http2.Connection.State × Option Grpc.Http2.Frame} (h : Grpc.Http2.Connection.WellFormed state) (hpending : Grpc.Http2.Connection.pendingHeaderStream? state.streams = none) (heq : Grpc.Http2.Connection.prepareHeadersShared state frame = Except.ok res), Grpc.Http2.Connection.WellFormed res.fst",
