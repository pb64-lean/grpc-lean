        "Grpc.Http2.Connection.processDataShared_inert_reset": "∀ {registry : Grpc.Registry} {state state' : Grpc.Http2.Connection.State} {frame : Grpc.Http2.Frame} {result : Grpc.Http2.Connection.SharedFrameResult} (hinert : state.StreamInert frame.header.streamId) (hnotrej : state.rejectedAtHeaders frame.header.streamId = false) (h : Grpc.Http2.Connection.processDataShared registry state frame = Except.ok (state', result)), result.requestFeeds = #[] ∧ result.detached = none ∧ result.requestStreaming = none ∧ (∀ (dispatch : Grpc.Http2.Connection.ActiveDispatch), dispatch ∈ result.cancelDispatches → dispatch.streamId = frame.header.streamId) ∧ state'.streams = Grpc.Http2.Connection.removeStream state.streams frame.header.streamId ∧ state'.lastClientStreamId = state.lastClientStreamId ∧ (∀ (active : Grpc.Http2.Connection.ActiveRequestStream), active ∈ state'.activeRequestStreams → active ∈ state.activeRequestStreams) ∧ (∃ rst, rst ∈ result.emitted ∧ rst.header.frameType = Grpc.Http2.FrameType.rstStream ∧ rst.header.streamId = frame.header.streamId)",
