# The TLS-facing layer declares no C of its own: every cryptographic primitive
# it reaches comes from tls13-lean's own audited HaclStar boundary, so no
# `@[extern]` may appear under `Grpc.Tls`.
#
# The audited environment is partitioned: `Grpc.Tls` is audited here;
# `Grpc.CancellationToken` is audited by `//:grpc_assurance` (under its `Grpc`
# prefix); the `Tls`/`TLS13`/`HaclStar` roots are tls13-lean modules audited by
# that repository's own assurance targets.
lean_assurance_test(
    name = "grpc_tls_assurance",
    policy_mode = "exact",
    principal_theorems = [],
    principal_theorem_types = {},
    allowed_axioms = [
        "propext",
        "Classical.choice",
        "Quot.sound",
    ],
    module_prefixes = ["Grpc.Tls"],
    unaudited_module_prefixes = [
        "Grpc.CancellationToken",
        "HaclStar",
        "TLS13",
        "Tls",
    ],
    expected_unsafe_constants = [],
    expected_partial_definitions = [
        "Grpc.Tls.Rest.acceptLoop",
        "Grpc.Tls.Rest.serveOneRequest",
        "Grpc.Tls.Rest.waitOwnedTasks",
        "Grpc.Tls.ServerSession.recvApp",
        "Grpc.Tls.Session.Grpc.Tls.clientHandshakeLoop",
        "Grpc.Tls.Session.Grpc.Tls.serverHandshakeLoop",
        "Grpc.Tls.Session.Grpc.Tls.writerLoop",
    ],
    expected_opaque_constants = [],
    expected_implemented_by = {},
    expected_extern_declarations = {},
    expected_native_targets = [
        "@tls13-lean++_repo_rules+hacl//:hacl",
        "@tls13-lean+//HaclStar:hacl_shim",
        "@tls13-lean+//HaclStar:lean_runtime_headers",
    ],
    deps = [":grpc_tls"],
)

