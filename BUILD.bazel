        "Grpc.Http2.Connection.prepareHeadersShared_no_reopen": "∀ {state : Grpc.Http2.Connection.State} {frame : Grpc.Http2.Frame} {res : Grpc.Http2.Connection.State × Option Grpc.Http2.Frame} (heq : Grpc.Http2.Connection.prepareHeadersShared state frame = Except.ok res) {claimed : Nat} (hclaimed : claimed ≤ state.lastClientStreamId), frame.header.streamId ≠ claimed",
